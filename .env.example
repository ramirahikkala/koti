# Copy to .env and fill in. The controller's whole world is the MQTT broker.

# --- MQTT (the integration bus - broker on the VM / mqtt.ketunmetsa.fi) ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# MQTT_TLS=true                 # set for the broker's TLS port (8883); then MQTT_PORT=8883
# MQTT_DISCOVERY_PREFIX=homeassistant
# MQTT_NODE_ID=heating_controller
# SENSOR_MAX_AGE_MINUTES=20     # a sensor topic older than this counts as unavailable

# --- Spot-Hinta price API ---
# SPOT_HINTA_API_JUSTNOW=https://api.spot-hinta.fi/JustNow
# SPOT_HINTA_API_URL=https://api.spot-hinta.fi/TodayAndDayForward

# --- Misc ---
TZ=Europe/Helsinki
# OUTDOOR_TEMP_TOPIC=koti/sensor/ruuvi_ulko_kodari/state
# HEALTHCHECK_URL=https://hc-ping.com/your-uuid-here
# ZONES_FILE=zones.yaml
# PRICE_AVG_EXCLUDE_TOP_HOURS=6.0

# Log intended actions instead of actuating (use for the shadow period).
DRY_RUN=false
