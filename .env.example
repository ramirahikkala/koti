# Copy to .env and fill in. Only HA_API_TOKEN is strictly required.

# --- Home Assistant ---
HA_URL=https://ha.ketunmetsa.fi
HA_API_TOKEN=

# --- MQTT (Home Assistant Mosquitto add-on) ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# MQTT_DISCOVERY_PREFIX=homeassistant
# MQTT_NODE_ID=heating_controller

# --- Spot-Hinta price API ---
# SPOT_HINTA_API_JUSTNOW=https://api.spot-hinta.fi/JustNow
# SPOT_HINTA_API_URL=https://api.spot-hinta.fi/TodayAndDayForward

# --- Misc ---
TZ=Europe/Helsinki
# OUTDOOR_TEMP_SENSOR=sensor.ruuvitag_dc2d_temperature
# HEALTHCHECK_URL=https://hc-ping.com/your-uuid-here
# ZONES_FILE=zones.yaml
# PRICE_AVG_EXCLUDE_TOP_HOURS=6.0

# Log intended actions instead of calling HA (use for the shadow period).
DRY_RUN=false
